# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Configuration
# Found in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role key for backend server operations (or anon key with appropriate RLS policies)
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# JWT Authentication Secret Key (Use a strong, unique secret in production)
JWT_SECRET=super_secret_jwt_key_task_manager_2026_modern_secure
JWT_EXPIRES_IN=7d
